---
import { getCollection } from 'astro:content';

// Import project images
import twoStrokeImg from '../assets/images/two-stroke.png';
import nextJsCourseImg from '../assets/images/next-js-course.png';
import storybookImg from '../assets/images/storybook.png';
import npmPackageImg from '../assets/images/npm-package.png';
import journalImg from '../assets/images/journal.png';
import gifAppImg from '../assets/images/gifApp.png';
import heroesImg from '../assets/images/heroes.png';
import blackjackImg from '../assets/images/blackjack.png';
import weatherImg from '../assets/images/weather.png';
import todoAppImg from '../assets/images/todo-app.png';
import restServerImg from '../assets/images/rest-server.png';
import nextDashboardImg from '../assets/images/next-js-dashboard.png';
import projectImg from '../assets/images/project.png';

const projects = await getCollection('projects', ({ data }) => {
	return !data.inProgress;
});

// Sort projects to put newest projects first
const sortedProjects = projects.sort((a, b) => {
	if (a.id === 'project-00.md') return -1;
	if (b.id === 'project-00.md') return 1;
	if (a.id === 'project-0.md') return -1;
	if (b.id === 'project-0.md') return 1;
	return a.id.localeCompare(b.id);
});

// Get first 3 featured projects for the main display
const featuredProjects = sortedProjects.slice(0, 3);

// Map images to projects
const imageMap = {
	'two-stroke': twoStrokeImg,
	'next-js-course': nextJsCourseImg,
	'storybook': storybookImg,
	'npm': npmPackageImg,
	'journal': journalImg,
	'gifApp': gifAppImg,
	'heroe': heroesImg,
	'blackjack': blackjackImg,
	'weather': weatherImg,
	'todo-app': todoAppImg,
	'rest-server': restServerImg,
	'next-js-dashboard': nextDashboardImg,
	'project': projectImg
};
---

<section
  id="projects"
  data-section="projects"
  data-testid="projects"
  class="py-20 px-8 lg:px-16 xl:px-24"
>
  <div class="max-w-6xl w-full mx-auto">
    <!-- Section header -->
    <div class="flex items-center mb-16">
      <h2 class="text-text-primary font-sans font-bold text-2xl md:text-3xl lg:text-4xl mr-4">
        <span class="text-accent font-monospace text-base md:text-lg font-normal">03.</span>
        Some Things I've Built
      </h2>
      <div class="flex-1 h-px bg-text-muted ml-6 max-w-xs"></div>
    </div>

    <!-- Featured Projects -->
    <div class="space-y-24 lg:space-y-32">
      {featuredProjects.map((project, index) => (
        <div class={`grid lg:grid-cols-12 gap-6 lg:gap-12 items-center ${index % 2 === 1 ? 'lg:text-right' : ''}`}>
          <!-- Project Image -->
          <div class={`lg:col-span-7 ${index % 2 === 1 ? 'lg:col-start-6 lg:order-2' : 'lg:col-start-1 lg:order-1'} relative group`}>
            <div class="relative overflow-hidden rounded-lg">
              <div class="bg-dark-secondary h-64 lg:h-80 flex items-center justify-center border border-text-muted group-hover:border-accent transition-all duration-300">
                {project.data.img_alt && imageMap[project.data.img_alt] ? (
                  <img 
                    src={imageMap[project.data.img_alt].src} 
                    alt={project.data.title}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="text-center">
                    <h3 class="text-accent font-monospace text-lg mb-2">{project.data.title}</h3>
                    <p class="text-text-muted text-sm">Project Screenshot</p>
                  </div>
                )}
              </div>
              <div class="absolute inset-0 bg-accent opacity-20 group-hover:opacity-0 transition-opacity duration-300"></div>
            </div>
          </div>

          <!-- Project Info -->
          <div class={`lg:col-span-5 ${index % 2 === 1 ? 'lg:col-start-1 lg:order-1' : 'lg:col-start-8 lg:order-2'} space-y-4`}>
            <p class="text-accent font-monospace text-sm">Featured Project</p>
            <h3 class="text-text-primary text-2xl lg:text-3xl font-bold">
              <a 
                href={project.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-accent transition-colors duration-300"
              >
                {project.data.title}
              </a>
            </h3>
            
            <div class="bg-dark-secondary p-6 rounded-lg border border-text-muted">
              <p class="text-text-secondary leading-relaxed">
                {project.data.description}
              </p>
            </div>
            
            <div class={`flex flex-wrap gap-3 ${index % 2 === 1 ? 'lg:justify-end' : ''}`}>
              {project.data.tags.map((tag: string) => (
                <span class="text-text-muted font-monospace text-sm">
                  {tag}
                </span>
              ))}
            </div>
            
            <div class={`flex gap-4 ${index % 2 === 1 ? 'lg:justify-end' : ''}`}>
              <a 
                href={project.data.goToRepo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-accent transition-colors duration-300"
                aria-label="GitHub Repository"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
              <a 
                href={project.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-accent transition-colors duration-300"
                aria-label="External Link"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Other Notable Projects -->
    <div class="mt-24 lg:mt-32">
      <h3 class="text-text-primary text-2xl font-bold text-center mb-12">Other Noteworthy Projects</h3>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedProjects.slice(3, 9).map((project) => (
          <div class="bg-dark-secondary p-6 rounded-lg border border-text-muted hover:border-accent hover:-translate-y-2 transition-all duration-300 group">
            <div class="flex justify-between items-start mb-6">
              <svg class="w-10 h-10 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v6a2 2 0 01-2 2H10a2 2 0 01-2-2V5z"/>
              </svg>
              <div class="flex gap-3">
                <a 
                  href={project.data.goToRepo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-text-muted hover:text-accent transition-colors duration-300"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </a>
                <a 
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-text-muted hover:text-accent transition-colors duration-300"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              </div>
            </div>
            
            <h4 class="text-text-primary text-xl font-semibold mb-3 group-hover:text-accent transition-colors duration-300">
              {project.data.title}
            </h4>
            <p class="text-text-secondary text-sm leading-relaxed mb-6">
              {project.data.description}
            </p>
            
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag: string) => (
                <span class="text-text-muted font-monospace text-xs">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Archive link -->
    <div class="text-center mt-16">
      <a
        href="https://github.com/jnahuel46"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-8 py-4 border-2 border-accent text-accent font-monospace text-sm tracking-wider hover:bg-accent hover:bg-opacity-10 transition-all duration-300 rounded-sm hover:-translate-y-1 hover:shadow-lg hover:shadow-accent/25"
      >
        Show More
      </a>
    </div>
  </div>
</section>
