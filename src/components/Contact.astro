---

<section
  id="contact"
  data-section="contact"
  data-testid="contact"
  class="min-h-screen flex items-center justify-center px-8 lg:px-16 xl:px-24 py-20"
>
  <div class="max-w-2xl w-full text-center">
    <!-- Section number -->
    <p class="text-accent font-monospace text-base md:text-lg mb-5">
      <span class="text-base md:text-lg">04.</span> What's Next?
    </p>
    
    <!-- Main heading -->
    <h2 class="text-text-primary font-sans font-bold text-3xl md:text-5xl lg:text-6xl mb-6 md:mb-8">
      Get In Touch
    </h2>
    
    <!-- Description -->
    <p class="text-text-secondary text-lg md:text-xl leading-relaxed mb-12 md:mb-16 max-w-xl mx-auto">
      Although I'm not currently looking for any new opportunities, my inbox is 
      always open. Whether you have a question or just want to say hi, I'll try 
      my best to get back to you!
    </p>
    
    <!-- CTA Button -->
    <a 
      href="mailto:jnahuel46@gmail.com"
      class="inline-block px-8 py-4 border-2 border-accent text-accent font-monospace text-sm tracking-wider hover:bg-accent hover:bg-opacity-10 transition-all duration-300 rounded-sm hover:-translate-y-1 hover:shadow-lg hover:shadow-accent/25"
    >
      Say Hello
    </a>
  </div>
</section>
