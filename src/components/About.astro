---
import engineerImage from '../assets/images/engineer.png';
---

<section
  id="about"
  data-section="about"
  data-testid="about"
  class="min-h-[88vh] flex items-center px-8 lg:px-16 xl:px-24 py-10"
>
  <div class="max-w-6xl w-full">
    <!-- Section header -->
    <div class="flex items-center mb-10 lg:mb-16">
      <h2 class="text-text-primary font-sans font-bold text-2xl md:text-3xl lg:text-4xl mr-4">
        <span class="text-accent font-monospace text-base md:text-lg font-normal">01.</span>
        About Me
      </h2>
      <div class="flex-1 h-px bg-text-muted ml-6 max-w-xs"></div>
    </div>

    <div class="grid lg:grid-cols-3 gap-12 lg:gap-16">
      <!-- Main content -->
      <div class="lg:col-span-2 space-y-6 text-text-secondary text-lg leading-relaxed">
        <p>
          Hello! I'm Jeremias, a Senior Software Engineer passionate about creating technological solutions 
          that impact thousands of users. My web development experience started in 2019, and since then 
          I've worked at startups leading product initiatives and developing scalable applications that 
          handle high traffic volumes.
        </p>

        <p>
          I've had the privilege of working at companies like 
          <span class="text-accent">Tech-House</span> and other projects, building robust digital solutions. 
          My main focus is maintaining high-demand websites and optimizing their performance, both in 
          frontend and cloud solutions.
        </p>

        <p>
          I hold certifications in <span class="text-accent">AWS (CLF-C02)</span>, 
          <span class="text-accent">AWS (AIF-C01)</span> and <span class="text-accent">Azure (AZ-900)</span>, 
          which allows me to design scalable and efficient cloud architectures.
        </p>

        <p class="mb-8">Here are a few technologies I've been working with recently:</p>
        
        <div class="grid grid-cols-2 gap-2 font-monospace text-sm">
          <div class="flex items-center">
            <span class="text-accent mr-3">▹</span>
            <span>JavaScript (ES6+)</span>
          </div>
          <div class="flex items-center">
            <span class="text-accent mr-3">▹</span>
            <span>TypeScript</span>
          </div>
          <div class="flex items-center">
            <span class="text-accent mr-3">▹</span>
            <span>React & Next.js</span>
          </div>
          <div class="flex items-center">
            <span class="text-accent mr-3">▹</span>
            <span>Node.js & NestJS</span>
          </div>
          <div class="flex items-center">
            <span class="text-accent mr-3">▹</span>
            <span>PostgreSQL</span>
          </div>
          <div class="flex items-center">
            <span class="text-accent mr-3">▹</span>
            <span>AWS & Azure</span>
          </div>
        </div>
      </div>

      <!-- Profile photo -->
      <div class="lg:col-span-1 flex justify-center lg:justify-end">
        <div class="relative group">
          <div class="w-64 h-64 md:w-80 md:h-80 lg:w-64 lg:h-64 xl:w-80 xl:h-80 rounded-lg bg-accent opacity-90 absolute -top-6 -left-6 z-0 group-hover:-top-4 group-hover:-left-4 transition-all duration-300"></div>
          <div class="relative z-10 w-64 h-64 md:w-80 md:h-80 lg:w-64 lg:h-64 xl:w-80 xl:h-80 rounded-lg overflow-hidden border-2 border-text-muted bg-dark-secondary group-hover:border-accent transition-all duration-300">
            <img 
              src={engineerImage.src} 
              alt="Jeremias Muriette - Software Engineer" 
              class="w-full h-full object-cover object-center"
            />
            <div class="absolute inset-0 bg-accent opacity-10 group-hover:opacity-5 transition-opacity duration-300"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
