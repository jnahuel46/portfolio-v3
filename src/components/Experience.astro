---
---

<section
  id="experience"
  data-section="experience"
  class="min-h-screen flex items-center px-8 lg:px-16 xl:px-24 py-10"
>
  <div class="max-w-6xl w-full">
    <!-- Section header -->
    <div class="flex items-center mb-10 lg:mb-16">
      <h2 class="text-text-primary font-sans font-bold text-2xl md:text-3xl lg:text-4xl mr-4">
        <span class="text-accent font-monospace text-base md:text-lg font-normal">02.</span>
        Where I've Worked
      </h2>
      <div class="flex-1 h-px bg-text-muted ml-6 max-w-xs"></div>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Tab buttons (left side on desktop, top on mobile) -->
      <div class="lg:min-w-max">
        <div class="flex lg:flex-col overflow-x-auto lg:overflow-visible">
          <button 
            class="experience-tab whitespace-nowrap px-6 py-3 text-left border-l-2 lg:border-l-2 lg:border-b-0 border-b-2 border-text-muted text-text-secondary hover:text-accent hover:border-accent hover:bg-dark-secondary transition-all duration-300 font-monospace text-sm active"
            data-tab="tech-house"
          >
            Tech-House
          </button>
          <button 
            class="experience-tab whitespace-nowrap px-6 py-3 text-left border-l-2 lg:border-l-2 lg:border-b-0 border-b-2 border-text-muted text-text-secondary hover:text-accent hover:border-accent hover:bg-dark-secondary transition-all duration-300 font-monospace text-sm"
            data-tab="stackzone"
          >
            StackZone
          </button>
          <button
            class="experience-tab whitespace-nowrap px-6 py-3 text-left border-l-2 lg:border-l-2 lg:border-b-0 border-b-2 border-text-muted text-text-secondary hover:text-accent hover:border-accent hover:bg-dark-secondary transition-all duration-300 font-monospace text-sm"
            data-tab="education"
          >
            Education
          </button>
        </div>
      </div>

      <!-- Tab content (right side) -->
      <div class="flex-1 min-h-[400px]">
        <!-- Tech-House experience -->
        <div id="tech-house" class="experience-content active">
          <div class="mb-2">
            <h3 class="text-text-primary text-xl lg:text-2xl font-semibold">
              Senior Software Engineer 
              <span class="text-accent">@ Tech-House</span>
            </h3>
            <p class="text-text-muted font-monospace text-sm">November 2024 - Present</p>
          </div>
          
          <div class="mt-6 space-y-4 text-text-secondary leading-relaxed">
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Senior Software Engineer specializing in Next.js, NestJs, NodeJs, TypeScript, React, ShadCN, Tailwind, tRPC, and React Query</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Experienced in building scalable, high-performance applications with modern frontend architectures</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Proficient in AWS deployments using ArgoCD and Helm, ensuring smooth CI/CD workflows</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Strong background in agile methodologies, utilizing tools like Jira for efficient collaboration</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Led the initiative and development of a company MVP from scratch, while also contributing to the maintenance and implementation of new features in a large-scale e-commerce platform</p>
            </div>
          </div>

          <div class="mt-6">
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">React</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">Next.js</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">TypeScript</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">NestJS</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">AWS</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">tRPC</span>
            </div>
          </div>
        </div>

        <!-- StackZone experience -->
        <div id="stackzone" class="experience-content">
          <div class="mb-2">
            <h3 class="text-text-primary text-xl lg:text-2xl font-semibold">
              Software Engineer - Frontend Lead 
              <span class="text-accent">@ StackZone LTD</span>
            </h3>
            <p class="text-text-muted font-monospace text-sm">November 2021 - November 2024</p>
          </div>
          
          <div class="mt-6 space-y-4 text-text-secondary leading-relaxed">
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>From November 2023 to December 2024 served as Frontend Leader</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Developed both frontend and backend solutions using React, TypeScript, Vite, Node.js, Prisma and AWS Serverless Application Model</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Led Frontend team and mentored new team members, fostering their growth and integration into the team</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Managed AWS cloud services including S3, Lambda, API Gateway, EC2, ECS, leveraging cloud infrastructure to ensure scalability and reliability</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p>Utilized Docker, Redis, PgAdmin, and Figma to streamline development processes, ensuring efficiency and quality in project management</p>
            </div>
          </div>

          <div class="mt-6">
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">React</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">TypeScript</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">Node.js</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">AWS</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">Prisma</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">Docker</span>
            </div>
          </div>
        </div>

        <!-- Education -->
        <div id="education" class="experience-content">
          <div class="mb-2">
            <h3 class="text-text-primary text-xl lg:text-2xl font-semibold">
              Education & Certifications 
              <span class="text-accent">@ Multiple Institutions</span>
            </h3>
            <p class="text-text-muted font-monospace text-sm">2018 - Present</p>
          </div>
          
          <div class="mt-6 space-y-4 text-text-secondary leading-relaxed">
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p><strong>Higher Technical Institute - TECLAB:</strong> Higher Technique in Programming (Ongoing)</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p><strong>AWS Certifications:</strong> Cloud Practitioner (CLF-C02) & AI Practitioner (AIF-C01) - December 2023</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p><strong>Microsoft Azure:</strong> Azure Fundamentals (AZ-900) - December 2024</p>
            </div>
            <div class="flex items-start">
              <span class="text-accent mr-3 mt-2 flex-shrink-0">▹</span>
              <p><strong>National Technical University (UTNFRC):</strong> Full Stack Web Programming Level 1 - December 2021</p>
            </div>
          </div>

          <div class="mt-6">
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">AWS</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">Azure</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">JavaScript</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">PHP</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">MySQL</span>
              <span class="px-3 py-1 text-xs font-monospace bg-dark-secondary text-accent border border-accent rounded">Java</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .experience-tab.active {
    @apply text-accent border-accent bg-dark-secondary;
  }
  
  .experience-content {
    @apply hidden;
  }
  
  .experience-content.active {
    @apply block;
  }
</style>

<script>
  function initExperienceTabs() {
    const tabs = document.querySelectorAll('.experience-tab');
    const contents = document.querySelectorAll('.experience-content');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab');

        if (targetTab) {
          // Remove active class from all tabs and contents
          tabs.forEach(t => t.classList.remove('active'));
          contents.forEach(c => c.classList.remove('active'));

          // Add active class to clicked tab and corresponding content
          tab.classList.add('active');
          const targetContent = document.getElementById(targetTab);
          if (targetContent) {
            targetContent.classList.add('active');
          }
        }
      });
    });
  }
  
  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', initExperienceTabs);
  
  // Re-initialize for Astro page navigation
  document.addEventListener('astro:page-load', initExperienceTabs);
</script>