---
// Icons drawn as 16x16 rect grids and flattened into one evenodd path, so the
// inner shapes punch through as holes and pick up whatever sits behind them.
type Rect = [x: number, y: number, w: number, h: number];

interface Props {
	name: 'github' | 'linkedin' | 'cv';
	class?: string;
}

const { name, class: className } = Astro.props;

const icons: Record<Props['name'], Rect[]> = {
	// Octocat. Ears sit flush with the head's outer corners — inset them and it
	// reads as a space invader's antennae instead of a cat.
	github: [
		[3, 1, 2, 2], // left ear
		[11, 1, 2, 2], // right ear
		[3, 3, 10, 5], // head
		[5, 5, 2, 2], // left eye (hole)
		[9, 5, 2, 2], // right eye (hole)
		[3, 8, 10, 5], // body
		[7, 11, 2, 2], // gap between the legs (hole)
		[13, 6, 2, 4], // tail
	],
	// Filled tile with "in" knocked out of it.
	linkedin: [
		[1, 1, 14, 14],
		[3, 3, 2, 2],
		[3, 6, 2, 7],
		[7, 6, 2, 7],
		[9, 6, 2, 2],
		[11, 6, 2, 7],
	],
	// Sheet with a folded corner and three lines of text.
	cv: [
		[3, 1, 10, 14],
		[10, 1, 3, 3],
		[5, 6, 6, 1],
		[5, 8, 6, 1],
		[5, 10, 4, 1],
	],
};

const path = icons[name].map(([x, y, w, h]) => `M${x} ${y}h${w}v${h}h${-w}z`).join('');
---

<svg
	viewBox="0 0 16 16"
	shape-rendering="crispEdges"
	fill="currentColor"
	fill-rule="evenodd"
	aria-hidden="true"
	class={className}
>
	<path d={path}></path>
</svg>
