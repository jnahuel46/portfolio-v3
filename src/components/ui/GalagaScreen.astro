---
// A CRT that plays itself until you take over. Everything is drawn on a 96x128
// virtual canvas with smoothing off, so the sprites stay true pixels however
// large the set gets scaled.
//
// States: attract (an AI demo, the default) -> playing -> paused / gameover.
// Keyboard is only ever captured while actually playing, so arrows and space
// keep scrolling the page the rest of the time.
---

<figure class="w-full">
	<!-- TV shell -->
	<div class="bg-panel-hi pixel-frame frame-line p-3">
		<div
			id="galaga-stage"
			tabindex="-1"
			class="bg-void pixel-frame frame-cyan relative aspect-3/4 w-full focus:outline-none"
		>
			<!-- HUD lives in the DOM so it uses the real display face -->
			<div
				class="font-display text-pixel-2xs pointer-events-none absolute inset-x-0 top-0 z-10 flex justify-between gap-2 p-2"
			>
				<span class="text-red animate-blink">1UP</span>
				<span id="galaga-score" class="text-text">00000</span>
				<span class="text-muted">HI</span>
				<span id="galaga-hi" class="text-yellow">00000</span>
			</div>

			<!-- The backing store is integer-scaled, but CSS still stretches it to
			     the element box; without this the browser resamples it smooth. -->
			<canvas
				id="galaga-canvas"
				class="h-full w-full"
				style="image-rendering: pixelated;"
				aria-hidden="true"></canvas>

			<!-- Lives, drawn as little fighters -->
			<div
				id="galaga-lives"
				class="pointer-events-none absolute bottom-0 left-0 z-10 flex gap-1 p-2"
			>
			</div>

			<!-- State overlay -->
			<!-- data-on rather than the `hidden` attribute: its UA `display:none`
			     loses to Tailwind's `flex` on source order. -->
			<div
				id="galaga-overlay"
				data-on="true"
				class="absolute inset-0 z-20 flex-col items-center justify-center gap-3 bg-black/85 p-4 text-center data-[on=false]:hidden data-[on=true]:flex"
			>
				<p id="galaga-overlay-title" class="text-yellow font-display text-pixel-xs animate-blink">
					GALAGA
				</p>
				<p id="galaga-overlay-note" class="text-dim font-display text-pixel-2xs leading-relaxed">
					DEMO MODE
				</p>
				<button
					id="galaga-play"
					type="button"
					class="bg-cyan text-void pixel-bevel pixel-press font-display text-pixel-2xs px-4 py-3"
				>
					▶ INSERT COIN
				</button>
				<p class="text-muted font-display text-pixel-2xs leading-relaxed">
					← → MOVE · SPACE FIRE · ESC QUIT
				</p>
			</div>
		</div>
	</div>

	<!-- Stand -->
	<div class="mx-auto flex w-full flex-col items-center">
		<div class="bg-panel-hi h-4 w-10"></div>
		<div class="bg-line h-2 w-24"></div>
	</div>

	<figcaption class="text-muted font-display text-pixel-2xs mt-4 text-center">
		<span id="galaga-caption">NOW PLAYING — GALAGA</span>
	</figcaption>
</figure>

<script>
	function initGalaga() {
		const el = document.getElementById('galaga-canvas');
		if (!(el instanceof HTMLCanvasElement)) return;
		const context = el.getContext('2d');
		if (!context) return;

		const canvas = el;
		const ctx = context;
		const stageEl = document.getElementById('galaga-stage');
		const scoreEl = document.getElementById('galaga-score');
		const hiEl = document.getElementById('galaga-hi');
		const livesEl = document.getElementById('galaga-lives');
		const overlayEl = document.getElementById('galaga-overlay');
		const titleEl = document.getElementById('galaga-overlay-title');
		const noteEl = document.getElementById('galaga-overlay-note');
		const playEl = document.getElementById('galaga-play');
		const captionEl = document.getElementById('galaga-caption');
		if (!stageEl || !overlayEl || !playEl) return;

		// Aliased after the guard so the nested functions below see non-null
		// types without a `!` on every single use.
		const stage = stageEl;
		const overlay = overlayEl;
		const playBtn = playEl;

		// Virtual resolution. Everything below is in these units.
		const W = 96;
		const H = 128;

		const C: Record<string, string> = {
			r: '#e52521', // Galaga red
			w: '#ffffff',
			b: '#2c56e0',
			y: '#ffc907',
			c: '#4fc3f7',
			p: '#a050c8', // boss body
			t: '#20c8a8', // boss wings
		};

		// 8x8 sprites. '.' is transparent; every other char indexes C.
		const SPRITES: Record<string, string[]> = {
			bee: [
				'.y....y.',
				'.yy..yy.',
				'..yyyy..',
				'.brrrrb.',
				'bbrrrrbb',
				'bb.rr.bb',
				'.b....b.',
				'........',
			],
			butterfly: [
				'..r..r..',
				'..rrrr..',
				'.rwwwwr.',
				'rrwwwwrr',
				'bb.rr.bb',
				'.b.rr.b.',
				'.b....b.',
				'........',
			],
			boss: [
				'..p..p..',
				'..pppp..',
				'.tpyypt.',
				'ttpyyptt',
				'tt.pp.tt',
				'.t.pp.t.',
				'.t....t.',
				'........',
			],
			fighter: [
				'...ww...',
				'...ww...',
				'..wwww..',
				'.wwrrww.',
				'.wwrrww.',
				'wwwwwwww',
				'w.w..w.w',
				'w......w',
			],
		};

		// Four frames: a spark that blooms outward and scatters.
		const BOOM: string[][] = [
			[
				'........',
				'........',
				'...yy...',
				'..yrry..',
				'..yrry..',
				'...yy...',
				'........',
				'........',
			],
			[
				'........',
				'..y..y..',
				'..yrry..',
				'.yrrrry.',
				'.yrrrry.',
				'..yrry..',
				'..y..y..',
				'........',
			],
			[
				'.y.y.y.y',
				'..y..y..',
				'.y.rr.y.',
				'y..rr..y',
				'y..rr..y',
				'.y.rr.y.',
				'..y..y..',
				'y.y.y.y.',
			],
			[
				'y.......',
				'...y...y',
				'.y....y.',
				'....y...',
				'y...y..y',
				'..y.....',
				'.y....y.',
				'.....y..',
			],
		];

		type Kind = 'bee' | 'butterfly' | 'boss';
		type Enemy = {
			kind: Kind;
			hx: number;
			hy: number;
			x: number;
			y: number;
			alive: boolean;
			diving: boolean;
			t: number;
			cx1: number;
			cy1: number;
			cx2: number;
			cy2: number;
			tx: number;
			ty: number;
		};
		type Shot = { x: number; y: number; vy: number; from: 'player' | 'enemy' };
		type Boom = { x: number; y: number; t: number };
		type Star = { x: number; y: number; v: number; c: string };
		type State = 'attract' | 'playing' | 'paused' | 'gameover';

		const COLS = 6;
		const ROWS = 3;
		const ROW_KIND: Kind[] = ['boss', 'butterfly', 'bee'];
		const HI_KEY = 'galaga-hi-score';
		const START_LIVES = 3;

		let enemies: Enemy[] = [];
		let shots: Shot[] = [];
		let booms: Boom[] = [];
		let stars: Star[] = [];
		let player = { x: W / 2 - 4, target: W / 2 - 4 };
		let state: State = 'attract';
		let score = 0;
		let hiScore = 0;
		let lives = START_LIVES;
		let invuln = 0;
		let nextDive = 1.2;
		let nextShot = 0.5;
		let nextEnemyShot = 1.5;
		let raf = 0;
		let last = 0;
		let elapsed = 0;

		// Input
		const held = new Set<string>();
		let touchX: number | null = null;
		let touchFiring = false;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

		try {
			hiScore = Number(localStorage.getItem(HI_KEY)) || 0;
		} catch {
			hiScore = 0;
		}

		function pad(n: number) {
			return String(n).padStart(5, '0');
		}

		function paintScore() {
			if (scoreEl) scoreEl.textContent = pad(score);
			if (hiEl) hiEl.textContent = pad(hiScore);
		}

		function paintLives() {
			if (!livesEl) return;
			livesEl.innerHTML = '';
			// Only meaningful while playing; the demo has no stakes.
			const count = state === 'attract' ? 0 : Math.max(0, lives);
			for (let i = 0; i < count; i++) {
				const dot = document.createElement('span');
				dot.className = 'bg-cyan inline-block h-2 w-2';
				livesEl.appendChild(dot);
			}
		}

		function setState(next: State) {
			state = next;
			overlay.dataset.on = String(next !== 'playing');

			if (titleEl && noteEl && captionEl) {
				if (next === 'attract') {
					titleEl.textContent = 'GALAGA';
					titleEl.classList.add('animate-blink');
					noteEl.textContent = 'DEMO MODE';
					playBtn.textContent = '▶ INSERT COIN';
					captionEl.textContent = 'NOW PLAYING — GALAGA';
				} else if (next === 'paused') {
					titleEl.textContent = 'PAUSED';
					titleEl.classList.remove('animate-blink');
					noteEl.textContent = '';
					playBtn.textContent = '▶ RESUME';
					captionEl.textContent = 'PAUSED';
				} else if (next === 'gameover') {
					titleEl.textContent = 'GAME OVER';
					titleEl.classList.remove('animate-blink');
					noteEl.textContent = `SCORE ${pad(score)}`;
					playBtn.textContent = '▶ PLAY AGAIN';
					captionEl.textContent = `GAME OVER — ${pad(score)}`;
				} else {
					captionEl.textContent = 'PLAYING — GOOD LUCK';
				}
			}
			paintLives();
		}

		function slotX(col: number) {
			return 12 + col * 12;
		}
		function slotY(row: number) {
			return 26 + row * 12;
		}

		function spawnFormation() {
			enemies = [];
			for (let row = 0; row < ROWS; row++) {
				for (let col = 0; col < COLS; col++) {
					enemies.push({
						kind: ROW_KIND[row],
						hx: slotX(col),
						hy: slotY(row),
						x: slotX(col),
						y: slotY(row),
						alive: true,
						diving: false,
						t: 0,
						cx1: 0,
						cy1: 0,
						cx2: 0,
						cy2: 0,
						tx: 0,
						ty: 0,
					});
				}
			}
		}

		function seedStars() {
			stars = [];
			const palette = ['#ffffff', '#ffffff', '#4fc3f7', '#ffc907', '#e52521'];
			for (let i = 0; i < 26; i++) {
				stars.push({
					x: Math.floor(Math.random() * W),
					y: Math.floor(Math.random() * H),
					v: 6 + Math.random() * 18,
					c: palette[Math.floor(Math.random() * palette.length)],
				});
			}
		}

		function startGame() {
			score = 0;
			lives = START_LIVES;
			invuln = 0;
			shots = [];
			booms = [];
			player.x = W / 2 - 4;
			spawnFormation();
			paintScore();
			setState('playing');
			stage.focus({ preventScroll: true });
			start();
		}

		function endGame() {
			if (score > hiScore) {
				hiScore = score;
				try {
					localStorage.setItem(HI_KEY, String(hiScore));
				} catch {
					/* private mode — the run just won't be remembered */
				}
			}
			paintScore();
			setState('gameover');
		}

		function quitToAttract() {
			shots = [];
			booms = [];
			spawnFormation();
			setState('attract');
		}

		function drawSprite(rows: string[], x: number, y: number) {
			for (let r = 0; r < rows.length; r++) {
				const line = rows[r];
				for (let c = 0; c < line.length; c++) {
					const ch = line[c];
					if (ch === '.') continue;
					ctx.fillStyle = C[ch] ?? '#ffffff';
					ctx.fillRect(Math.round(x) + c, Math.round(y) + r, 1, 1);
				}
			}
		}

		function startDive(enemy: Enemy) {
			enemy.diving = true;
			enemy.t = 0;
			const dir = Math.random() < 0.5 ? -1 : 1;
			enemy.cx1 = enemy.hx + dir * 34;
			enemy.cy1 = enemy.hy + 26;
			enemy.cx2 = player.x - dir * 24;
			enemy.cy2 = H - 42;
			enemy.tx = player.x + (Math.random() * 24 - 12);
			enemy.ty = H + 10;
		}

		function bezier(p0: number, p1: number, p2: number, p3: number, t: number) {
			const u = 1 - t;
			return u * u * u * p0 + 3 * u * u * t * p1 + 3 * u * t * t * p2 + t * t * t * p3;
		}

		function hitPlayer() {
			if (invuln > 0) return;
			lives -= 1;
			invuln = 1.6;
			booms.push({ x: player.x, y: H - 14, t: 0 });
			paintLives();
			if (lives <= 0) endGame();
		}

		function update(dt: number) {
			elapsed += dt;
			const live = state === 'playing';

			for (const star of stars) {
				star.y += star.v * dt;
				if (star.y > H) {
					star.y = -1;
					star.x = Math.floor(Math.random() * W);
				}
			}

			const sway = Math.sin(elapsed * 0.9) * 5;

			if (enemies.every((e) => !e.alive)) {
				spawnFormation();
				return;
			}

			for (const enemy of enemies) {
				if (!enemy.alive) continue;
				if (!enemy.diving) {
					enemy.x = enemy.hx + sway;
					enemy.y = enemy.hy;
					continue;
				}
				enemy.t += dt * 0.55;
				if (enemy.t >= 1) {
					enemy.diving = false;
					enemy.t = 0;
					enemy.x = enemy.hx;
					enemy.y = enemy.hy;
					continue;
				}
				enemy.x = bezier(enemy.hx + sway, enemy.cx1, enemy.cx2, enemy.tx, enemy.t);
				enemy.y = bezier(enemy.hy, enemy.cy1, enemy.cy2, enemy.ty, enemy.t);
			}

			nextDive -= dt;
			if (nextDive <= 0) {
				nextDive = (live ? 0.9 : 1.1) + Math.random() * 1.6;
				const idle = enemies.filter((e) => e.alive && !e.diving);
				if (idle.length) startDive(idle[Math.floor(Math.random() * idle.length)]);
			}

			// --- Player control -------------------------------------------------
			if (live) {
				const SPEED = 62;
				if (touchX !== null) {
					player.x += (touchX - 4 - player.x) * Math.min(1, dt * 12);
				} else {
					if (held.has('left')) player.x -= SPEED * dt;
					if (held.has('right')) player.x += SPEED * dt;
				}
				player.x = Math.max(1, Math.min(W - 9, player.x));

				if (invuln > 0) invuln -= dt;

				nextShot -= dt;
				const firing = held.has('fire') || touchFiring;
				if (firing && nextShot <= 0) {
					nextShot = 0.22;
					shots.push({ x: player.x + 3, y: H - 22, vy: -110, from: 'player' });
				}

				// Enemies shoot back, but only from the ones actually diving.
				nextEnemyShot -= dt;
				if (nextEnemyShot <= 0) {
					nextEnemyShot = 0.8 + Math.random() * 1.4;
					const divers = enemies.filter((e) => e.alive && e.diving);
					if (divers.length) {
						const from = divers[Math.floor(Math.random() * divers.length)];
						shots.push({ x: from.x + 3, y: from.y + 8, vy: 52, from: 'enemy' });
					}
				}
			} else {
				// Attract mode flies itself.
				const threat = enemies.find((e) => e.alive && e.diving);
				player.target = threat
					? Math.max(2, Math.min(W - 10, threat.x))
					: W / 2 - 4 + Math.sin(elapsed * 0.6) * 26;
				player.x += (player.target - player.x) * Math.min(1, dt * 4);

				nextShot -= dt;
				if (nextShot <= 0) {
					nextShot = 0.42 + Math.random() * 0.3;
					shots.push({ x: player.x + 3, y: H - 22, vy: -84, from: 'player' });
				}
			}

			for (const shot of shots) shot.y += shot.vy * dt;
			shots = shots.filter((s) => s.y > -4 && s.y < H + 4);

			// --- Collisions -----------------------------------------------------
			for (const shot of shots) {
				if (shot.from === 'player') {
					for (const enemy of enemies) {
						if (!enemy.alive) continue;
						if (
							shot.x >= enemy.x &&
							shot.x <= enemy.x + 8 &&
							shot.y >= enemy.y &&
							shot.y <= enemy.y + 8
						) {
							enemy.alive = false;
							shot.y = -99;
							booms.push({ x: enemy.x, y: enemy.y, t: 0 });
							score += enemy.kind === 'boss' ? 150 : enemy.kind === 'butterfly' ? 80 : 50;
							paintScore();
							break;
						}
					}
				} else if (live && invuln <= 0) {
					if (shot.x >= player.x && shot.x <= player.x + 8 && shot.y >= H - 14 && shot.y <= H - 6) {
						shot.y = 999;
						hitPlayer();
					}
				}
			}

			// A diving enemy that reaches you also hurts.
			if (live && invuln <= 0) {
				for (const enemy of enemies) {
					if (!enemy.alive || !enemy.diving) continue;
					if (Math.abs(enemy.x - player.x) < 7 && Math.abs(enemy.y - (H - 14)) < 7) {
						enemy.alive = false;
						booms.push({ x: enemy.x, y: enemy.y, t: 0 });
						hitPlayer();
						break;
					}
				}
			}

			for (const boom of booms) boom.t += dt;
			booms = booms.filter((b) => b.t < 0.32);
		}

		function render() {
			ctx.fillStyle = '#000000';
			ctx.fillRect(0, 0, W, H);

			for (const star of stars) {
				ctx.fillStyle = star.c;
				ctx.fillRect(Math.round(star.x), Math.round(star.y), 1, 1);
			}

			for (const enemy of enemies) {
				if (!enemy.alive) continue;
				drawSprite(SPRITES[enemy.kind], enemy.x, enemy.y);
			}

			for (const boom of booms) {
				const frame = Math.min(BOOM.length - 1, Math.floor((boom.t / 0.32) * BOOM.length));
				drawSprite(BOOM[frame], boom.x, boom.y);
			}

			for (const shot of shots) {
				ctx.fillStyle = shot.from === 'player' ? '#ffffff' : '#e52521';
				ctx.fillRect(Math.round(shot.x), Math.round(shot.y), 1, 3);
			}

			// Blink the fighter while it is respawn-invulnerable.
			const hidden = invuln > 0 && Math.floor(invuln * 12) % 2 === 0;
			if (!(state === 'gameover' || hidden)) drawSprite(SPRITES.fighter, player.x, H - 14);
		}

		function frame(now: number) {
			const dt = Math.min(0.05, (now - last) / 1000 || 0);
			last = now;
			update(dt);
			render();
			raf = requestAnimationFrame(frame);
		}

		function resize() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const rect = canvas.getBoundingClientRect();
			// Integer scale keeps every virtual pixel the same size on screen.
			const scale = Math.max(1, Math.floor((rect.width * dpr) / W));
			canvas.width = W * scale;
			canvas.height = H * scale;
			ctx.setTransform(scale, 0, 0, scale, 0, 0);
			ctx.imageSmoothingEnabled = false;
		}

		function stop() {
			cancelAnimationFrame(raf);
			raf = 0;
		}

		function start() {
			if (raf) return;
			last = performance.now();
			raf = requestAnimationFrame(frame);
		}

		// --- Input --------------------------------------------------------------
		const KEYS: Record<string, string> = {
			ArrowLeft: 'left',
			KeyA: 'left',
			ArrowRight: 'right',
			KeyD: 'right',
			Space: 'fire',
			ArrowUp: 'fire',
			KeyW: 'fire',
		};

		// Every key that would scroll the page has to be swallowed mid-game, not
		// just the ones the game uses — otherwise ArrowDown yanks the board out
		// from under you while you are playing.
		const SCROLLS = new Set([
			'ArrowLeft',
			'ArrowRight',
			'ArrowUp',
			'ArrowDown',
			'Space',
			'PageUp',
			'PageDown',
			'Home',
			'End',
		]);

		window.addEventListener('keydown', (event) => {
			// Outside a running game the keyboard belongs to the page.
			if (state !== 'playing') return;
			if (event.code === 'Escape') {
				quitToAttract();
				return;
			}
			if (SCROLLS.has(event.code)) event.preventDefault();
			const action = KEYS[event.code];
			if (action) held.add(action);
		});

		window.addEventListener('keyup', (event) => {
			const action = KEYS[event.code];
			if (action) held.delete(action);
		});

		playBtn.addEventListener('click', () => {
			if (state === 'paused') {
				setState('playing');
				stage.focus({ preventScroll: true });
				start();
			} else {
				startGame();
			}
		});

		// Leaving the cabinet pauses rather than ends the run.
		stage.addEventListener('focusout', (event) => {
			if (state !== 'playing') return;
			if (stage.contains(event.relatedTarget as Node)) return;
			held.clear();
			setState('paused');
		});

		function touchTo(event: TouchEvent) {
			const touch = event.touches[0];
			if (!touch) return;
			const rect = canvas.getBoundingClientRect();
			touchX = ((touch.clientX - rect.left) / rect.width) * W;
		}

		canvas.addEventListener(
			'touchstart',
			(event) => {
				if (state !== 'playing') return;
				event.preventDefault();
				touchFiring = true;
				touchTo(event);
			},
			{ passive: false }
		);
		canvas.addEventListener(
			'touchmove',
			(event) => {
				if (state !== 'playing') return;
				event.preventDefault();
				touchTo(event);
			},
			{ passive: false }
		);
		canvas.addEventListener('touchend', () => {
			touchFiring = false;
			touchX = null;
		});

		// --- Boot ---------------------------------------------------------------
		spawnFormation();
		seedStars();
		resize();
		paintScore();
		setState('attract');
		render();

		let resizeTimer: number;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				resize();
				render();
			}, 150);
		});

		// The demo respects reduced motion; an explicit game is the user's call.
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const visible = entry.isIntersecting && !document.hidden;
					if (!visible) {
						stop();
						if (state === 'playing') {
							held.clear();
							setState('paused');
						}
					} else if (state === 'attract' && reduced.matches) {
						// leave the static frame in place
					} else if (state === 'attract' || state === 'playing') {
						start();
					}
				}
			},
			{ threshold: 0.1 }
		);
		io.observe(canvas);

		document.addEventListener('visibilitychange', () => {
			if (!document.hidden) return;
			stop();
			if (state === 'playing') {
				held.clear();
				setState('paused');
			}
		});
	}

	initGalaga();
	document.addEventListener('astro:page-load', initGalaga);
</script>
