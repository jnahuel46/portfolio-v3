---
// Decorative CRT drawn on a 32x28 pixel grid. Every coordinate is an integer so
// `crispEdges` renders it as true pixel art at any scale.
const codeLines = [
	{
		y: 5,
		runs: [
			{ x: 7, w: 6, c: 'cyan' },
			{ x: 14, w: 4, c: 'magenta' },
		],
	},
	{ y: 7, runs: [{ x: 7, w: 10, c: 'line' }] },
	{
		y: 9,
		runs: [
			{ x: 9, w: 8, c: 'yellow' },
			{ x: 18, w: 3, c: 'green' },
		],
	},
	{ y: 11, runs: [{ x: 9, w: 5, c: 'line' }] },
	{
		y: 13,
		runs: [
			{ x: 7, w: 7, c: 'cyan' },
			{ x: 15, w: 5, c: 'line' },
		],
	},
];
---

<svg
	viewBox="0 0 32 28"
	shape-rendering="crispEdges"
	role="img"
	aria-label="Pixel art illustration of a CRT monitor showing code"
	class="w-full"
>
	<!-- Bezel -->
	<rect x="2" y="0" width="28" height="21" fill="var(--color-panel-hi)"></rect>
	<rect x="3" y="1" width="26" height="19" fill="var(--color-panel)"></rect>

	<!-- Screen -->
	<rect x="5" y="3" width="22" height="15" fill="var(--color-void)"></rect>

	{
		codeLines.map((line) =>
			line.runs.map((run) => (
				<rect x={run.x} y={line.y} width={run.w} height="1" fill={`var(--color-${run.c})`} />
			))
		)
	}

	<!-- Prompt cursor -->
	<rect x="7" y="15" width="2" height="1" fill="var(--color-green)" class="animate-blink"></rect>

	<!-- Power LED -->
	<rect x="26" y="19" width="1" height="1" fill="var(--color-red)" class="animate-blink"></rect>

	<!-- Stand and base -->
	<rect x="13" y="21" width="6" height="3" fill="var(--color-panel-hi)"></rect>
	<rect x="9" y="24" width="14" height="2" fill="var(--color-line)"></rect>
</svg>
