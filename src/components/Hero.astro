---
import engineerImage from '@assets/images/engineer.png';
import { Image } from 'astro:assets';
---

<section
	id="home"
	data-section="home"
	data-testid="hero"
	class="flex min-h-[calc(100vh-3.5rem)] items-center px-4 py-12 sm:px-8 md:min-h-[calc(100vh-4rem)] lg:px-16"
>
	<div class="grid w-full max-w-6xl gap-12 lg:grid-cols-12 lg:items-center">
		<div class="lg:col-span-7">
			<p
				class="text-green font-display text-pixel-2xs sm:text-pixel-xs mb-6 flex items-center gap-2"
			>
				<span class="bg-green inline-block h-2 w-2"></span>
				PLAYER 1 — READY
			</p>

			<h1 class="text-hard-shadow mb-6 leading-relaxed">
				<span class="text-text text-pixel-xl sm:text-pixel-2xl lg:text-pixel-3xl block"
					>JEREMIAS</span
				>
				<span class="text-green text-pixel-xl sm:text-pixel-2xl lg:text-pixel-3xl block"
					>MURIETTE</span
				>
			</h1>

			<p class="text-bright font-display text-pixel-xs sm:text-pixel-sm lg:text-pixel-base mb-8">
				I BUILD DIGITAL EXPERIENCES
			</p>

			<p class="text-dim mb-10 max-w-xl">
				Senior Software Engineer specialised in React, Next.js, NestJS, TypeScript and AWS. I build
				scalable applications and squeeze performance out of high-traffic websites.
			</p>

			<div class="flex flex-col gap-4 sm:flex-row">
				<a
					href="#projects"
					class="bg-green text-void pixel-bevel pixel-press font-display text-pixel-2xs sm:text-pixel-xs inline-flex items-center justify-center gap-3 px-6 py-4"
				>
					<span aria-hidden="true">▶</span> START
				</a>
				<a
					href="/jere-muriette-se.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="text-green pixel-frame frame-green pixel-press hover:bg-panel font-display text-pixel-2xs sm:text-pixel-xs inline-flex items-center justify-center px-6 py-4"
				>
					CONTINUE (CV)
				</a>
			</div>

			<p class="text-muted font-display text-pixel-2xs animate-blink mt-12">▼ SCROLL TO CONTINUE</p>
		</div>

		<div class="lg:col-span-5">
			<figure class="mx-auto w-full max-w-md">
				<div class="bg-panel pixel-frame frame-green p-2">
					<Image
						src={engineerImage}
						alt="Jeremias Muriette"
						widths={[448, 896]}
						sizes="(min-width: 1024px) 448px, 90vw"
						loading="eager"
						class="aspect-square w-full object-cover"
					/>
				</div>
				<figcaption
					class="bg-green text-void font-display text-pixel-2xs mt-2 px-3 py-2 text-center"
				>
					JEREMIAS.PNG
				</figcaption>
			</figure>
		</div>
	</div>
</section>
